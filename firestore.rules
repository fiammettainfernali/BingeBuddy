rules_version = '2';

// BingeBuddy Firestore security rules (hardened per AUDIT.md §2.1).
// Private 2-person app: only signed-in members of a household can touch its data.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /households/{householdId} {
      // Fetching a single household by its exact code is allowed (join-by-code needs it)...
      allow get: if request.auth != null;

      // ...but listing/querying only ever returns households you belong to.
      // (The app's own membership query — arrayContains: uid — satisfies this.)
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.memberUids;

      // Create only if you put yourself in the member list (max 2 people).
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberUids
                    && request.resource.data.memberUids.size() <= 2;

      // Update: either you're already a member, or this is a join —
      // which may only append yourself to a household that has room,
      // without removing anyone or erasing existing member names.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberUids
        || (
          !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 2
          && request.resource.data.memberNames.keys().hasAll(resource.data.memberNames.keys())
        )
      );

      // Only the last remaining member may delete the household (account deletion).
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.memberUids
                    && resource.data.memberUids.size() == 1;

      // Everything inside a household (library items, together, suggestions, prefs)
      // is members-only.
      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
      }
    }
  }
}
